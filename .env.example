# Application port (Render will inject its own PORT automatically)
PORT=3000

# Node environment: development or production
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local)
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local example:  mongodb://localhost:27017/questionnaire
MONGODB_URI=mongodb://localhost:27017/questionnaire

# MongoDB database name
MONGODB_DB_NAME=questionnaire
